# Copy this file to .env and fill in your values

# production | development  (Railway ถูกตรวจเป็น production อัตโนมัติ)
APP_ENV=development

SECRET_KEY=your-secret-key-here-change-this

# Leave blank to use SQLite locally
# Railway will set this automatically when you add PostgreSQL plugin
DATABASE_URL=

# LINE Notify (optional)
LINE_NOTIFY_TOKEN=

# Telegram Bot (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Field app ↔ SAPKAT CRM (ว่าง = ปิดการเชื่อม CRM)
FIELD_CRM_API_KEY=

# โฟลเดอร์เก็บไฟล์อัปโหลด — production ต้องชี้ไป persistent volume เช่น /data/uploads
UPLOAD_FOLDER=

# รหัสผ่านบัญชีเริ่มต้นตอนสร้างฐานข้อมูลใหม่ (production ถ้าไม่ตั้ง จะสุ่มและพิมพ์ลง log ครั้งเดียว)
INITIAL_ADMIN_PASSWORD=
